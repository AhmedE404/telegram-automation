# ──────────────────────────────────────────────────────────────────────────────
# Telegram Automation Suite — Environment Variables
#
# Copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed to Git.
# .env.example is safe to commit — it contains no real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram (required) ───────────────────────────────────────────────────────
# Obtain credentials from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Telegram session storage path (defaults to session/telegram)
# SESSION_NAME=session/telegram

# ── Application Mode ──────────────────────────────────────────────────────────
# APP_MODE controls startup behavior:
#   production  (default) — Runs ACTIVE_AUTOMATIONS unattended without prompts
#   local                 — Displays an interactive selection menu on startup
APP_MODE=production

# Comma-separated list of automations to run in production mode
ACTIVE_AUTOMATIONS=link_sniper

# ── Browser Configuration ─────────────────────────────────────────────────────
# Run Chrome in headless mode (no visible window).
#   false (default) — Visible window; recommended for monitoring and avoiding bot flags
#   true            — Headless mode; for fully unattended servers
BROWSER_HEADLESS=false

# Remote debugging port for DrissionPage (dedicated port avoids conflicts)
# BROWSER_PORT=9555

# Maximum duration (seconds) before abandoning a stalled URL batch
# BROWSER_BATCH_TIMEOUT=120

# ── Browser Profile Persistence (optional) ───────────────────────────────────
# Save Chrome login sessions, cookies, and tokens across runs.
#   false (default) — Disabled; fresh temporary browser state
#   true            — Enabled; saves session to BROWSER_USER_DATA_DIR
BROWSER_USE_PROFILE=false
# BROWSER_USER_DATA_DIR=browser_profile

# ── Channels ──────────────────────────────────────────────────────────────────
# Target channel for link_sniper (defaults to @samsshopofficial)
LINK_SNIPER_TARGET_CHANNEL=@samsshopofficial

# Optional private test channel (used for sandbox testing before going live)
TEST_CHANNEL_ID=-1001234567890

# Toggle test mode:
#   false (default) — Automations listen to their production target channels
#   true            — Automations listen to TEST_CHANNEL_ID instead
USE_TEST_CHANNEL=false

# Maximum time (seconds) to poll each page for the claim button (defaults to 1.2s)
# BUTTON_POLL_TIMEOUT=1.2
